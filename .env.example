# Production template: fill existing credentials; do not rotate TOTP_ENCRYPTION_KEY
# when upgrading, because it encrypts TOTP secrets and saved source API keys.
# API URLs / source keys / polling intervals: Settings > Log API (stored in DB).
# AI key / model / Slack webhook: Settings > Integrations (stored in DB).

POSTGRES_USER=siem
POSTGRES_DB=siem
# Use a URL-safe password; DATABASE_URL is composed from these values.
POSTGRES_PASSWORD=
JWT_SECRET=
INGEST_API_KEY=
DETECTION_API_KEY=
PDF_RENDER_KEY=
# 64 hex characters, preserve the existing value on upgrades.
TOTP_ENCRYPTION_KEY=
TOTP_ISSUER=KKUSIEM
# Initial empty DB only: SeedService creates admin from this value; clear after initialization.
BOOTSTRAP_ADMIN_PASSWORD=

PUBLIC_ORIGIN=https://siem.kku.ac.th
HTTP_PORT=80
HTTPS_PORT=443
SSO_WEB_URL=https://sso-uat-web.kku.ac.th
SSO_API_URL=https://sso-uat-api.kku.ac.th
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# Must match the callback registered for this client; UAT may use a different API URL.
SSO_CALLBACK_URL=https://siem.kku.ac.th/callback

LOG_COLLECTION_MODE=api
LOG_SCOPE=related
STATIC_ANALYSIS_MODE=false
SIEM_RESPONSE_MODE=disabled
FIREWALL_SENSOR_IP=
NGINX_SENSOR_IP=
OUTBOUND_ALLOWED_HOSTS=gen.ai.kku.ac.th,hooks.slack.com,.webhook.office.com,sso-uat-api.kku.ac.th,cveawg.mitre.org
OUTBOUND_PRIVATE_HOSTS=
# Defaults inherit PUBLIC_ORIGIN when empty.
SIEM_PUBLIC_BASE_URL=
SIEM_MCP_ALLOWED_ORIGINS=
# Add only the actual NGINX container/proxy IP or explicitly trusted proxy CIDR.
SIEM_TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128

MAX_LOG_BYTES=65536
DETECTION_MAX_BATCH_SIZE=250
DETECTION_MAX_BATCH_BYTES=2097152
MAX_PENDING_EVENTS=100000
MAX_DETECTION_ATTEMPTS=5
MAX_RECEIPT_WRITES=4
MAX_API_LOG_WRITES=16
MAX_HTTP_BODY_REQUESTS=8
LOG_API_MAX_RECORDS=1000
LOG_API_MAX_RESPONSE_BYTES=2097152
LOG_API_TIMEOUT_MS=15000
MAX_ACTIVE_IPS=1024
MAX_ACTIVE_SESSIONS=2048
INCIDENT_CACHE_SIZE=200
DETECTION_MAX_INFLIGHT_REQUESTS=4
FW_SCAN_PORTS=20
FW_SCAN_HOSTS=20
FW_DENY_BURST=100
MAX_WS_CLIENTS=32
MAX_WS_PENDING_PACKETS=128
MAX_WS_PENDING_BYTES=8388608
MEMORY_DIAGNOSTICS_LOG=false

NGINX_MEMORY_LIMIT=128m
FRONTEND_MEMORY_LIMIT=384m
BACKEND_MEMORY_LIMIT=768m
PDF_MEMORY_LIMIT=512m
DETECTION_MEMORY_LIMIT=512m
POSTGRES_MEMORY_LIMIT=1g
