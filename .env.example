# ============================================================
#  KKUSIEM Honeypot Dashboard — Environment Configuration
# ============================================================
#  วิธีใช้: cp .env.example .env  แล้วแก้ค่าตามต้องการ
#  ❌ ห้าม commit ไฟล์ .env จริง (อยู่ใน .gitignore แล้ว)
# ============================================================


# ============================================================
#  DATABASE (PostgreSQL 16)
# ============================================================
# ใช้สำหรับเก็บข้อมูล attack events, user accounts, login sessions
# เปลี่ยน password ก่อน deploy จริง ทุกครั้ง!

POSTGRES_USER=admin
POSTGRES_PASSWORD=ChangeMe_Strong_Password_Here
POSTGRES_DB=honeypot


# ============================================================
#  SECURITY
# ============================================================
# ใช้เซ็น JWT token สำหรับ session authentication
# ต้องเป็น string ยาวและสุ่ม (อย่างน้อย 32 ตัวอักษร)
# สร้างได้ด้วย: openssl rand -hex 32

JWT_SECRET=replace-with-random-secret-min-32-chars


# ============================================================
#  PORTS — แก้ที่นี่ที่เดียว docker-compose จะใช้ค่าเหล่านี้ทั้งหมด
# ============================================================
#
#  ภาพรวมสถาปัตยกรรม Port:
#
#  INTERNET
#     │
#     ├── :HTTP_PORT  (80/18080)   ─→  Nginx  ─→  redirect ไป HTTPS
#     ├── :HTTPS_PORT (443/18443)  ─→  Nginx  ─→  Frontend + Backend API
#     │                                           (internal port ไม่เปิดออก)
#     ├── :COWRIE_SSH_PORT  (22222) ─→  Cowrie SSH Honeypot  (จริงๆ ควรใช้ 22)
#     ├── :COWRIE_TELNET_PORT (22223) ─→ Cowrie Telnet Honeypot
#     ├── :WEBTRAP_HTTP_PORT  (28081) ─→ WebTrap HTTP Honeypot  (หลอกล่อ)
#     └── :WEBTRAP_HTTPS_PORT (28444) ─→ WebTrap HTTPS Honeypot (หลอกล่อ)
#
#  Internal (ไม่เปิดออก internet):
#     frontend  :3000   (เข้าผ่าน Nginx เท่านั้น)
#     backend   :5000   (เข้าผ่าน Nginx เท่านั้น)
#     postgres  :5432   (internal only)
#     redis     :6379   (internal only)
# ============================================================


# ── Web Dashboard (Nginx Reverse Proxy) ──────────────────────
# Port ที่ user เปิดเบราว์เซอร์เข้ามา
# Production: ตั้งเป็น 80 และ 443
# Development/Demo: ใช้ non-standard เพื่อหลีกเลี่ยง conflict

HTTP_PORT=18080
# ↑ http://SERVER_IP:18080  จะ redirect ไป HTTPS อัตโนมัติ

HTTPS_PORT=18443
# ↑ https://SERVER_IP:18443  ← URL หลักที่ใช้เปิด Dashboard


# ── SSH/Telnet Honeypot (Cowrie) ─────────────────────────────
# Port ที่ต้องการให้ attacker มา connect เพื่อดัก credential
# หากต้องการให้ดักที่ port 22 จริงๆ:
#   COWRIE_SSH_PORT=22  (แต่ต้องย้าย SSH จริงของ server ไปก่อน เช่น 2200)
# Port 2222 ใน container จะ map มาที่ COWRIE_SSH_PORT บน host

COWRIE_SSH_PORT=22222
# ↑ attacker ทดลอง connect: ssh admin@SERVER_IP -p 22222

COWRIE_TELNET_PORT=22223
# ↑ attacker ทดลอง telnet: telnet SERVER_IP 22223


# ── Web Vulnerability Honeypot (WebTrap) ─────────────────────
# Port ที่แสดงหน้า "Admin Portal" ปลอมเพื่อดัก SQL Inject, XSS, Path Traversal
# ควรเปิด Port เหล่านี้ใน firewall ให้ internet เข้าถึงได้

WEBTRAP_HTTP_PORT=28081
# ↑ attacker เห็นว่ามีเว็บ: http://SERVER_IP:28081

WEBTRAP_HTTPS_PORT=28444
# ↑ attacker เห็น HTTPS: https://SERVER_IP:28444
