# ============================================================
# KKUSIEM Honeypot Dashboard - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to Git (it's in .gitignore)
# ============================================================

# ============================================================
# DATABASE (PostgreSQL)
# ============================================================
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=honeypot

# ============================================================
# SECURITY
# ============================================================
JWT_SECRET=super-secret-jwt-key-change-me-in-production

# ============================================================
# EXTERNAL INTEGRATIONS
# ============================================================
NGROK_AUTHTOKEN=your_ngrok_auth_token_here

# ============================================================
# PORTS — แก้ที่นี่ที่เดียว docker-compose จะใช้ค่าเหล่านี้
# ============================================================

# Web Dashboard (Nginx)
HTTP_PORT=18080
HTTPS_PORT=18443

# SSH/Telnet Honeypot (Cowrie)
COWRIE_SSH_PORT=22222
COWRIE_TELNET_PORT=22223

# Web Vulnerability Honeypot (WebTrap)
WEBTRAP_HTTP_PORT=28081
WEBTRAP_HTTPS_PORT=28444
