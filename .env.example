# ============================================================
# KKUSIEM Honeypot Dashboard - Environment Template
# ============================================================
# Copy this file to .env and fill in your actual values
# This file is safe to commit to Git (no real secrets)
# ============================================================

# --- Database (PostgreSQL) ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=honeypot

# --- Security ---
JWT_SECRET=change-this-to-a-strong-random-secret-in-production

# --- External Integrations ---
NGROK_AUTHTOKEN=your_ngrok_auth_token_here

# --- Ports (ปรับที่นี่ที่เดียว) ---
HTTP_PORT=80
HTTPS_PORT=443
COWRIE_SSH_PORT=2222
COWRIE_TELNET_PORT=2223
WEBTRAP_HTTP_PORT=8081
WEBTRAP_HTTPS_PORT=8444
