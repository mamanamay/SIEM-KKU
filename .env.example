# ============================================================
#  KKUSIEM Honeypot Dashboard — Environment Configuration
# ============================================================
#  วิธีใช้: cp .env.example .env → แก้ค่าที่ต้องการ → docker compose up -d --build
#
#  ❗ ห้าม commit ไฟล์ .env จริงขึ้น Git โดยเด็ดขาด
# ============================================================


# ============================================================
#  [1] DATABASE — PostgreSQL 16
# ============================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ChangeMe_StrongPassword_Here
POSTGRES_DB=honeypot

# DATABASE_URL สร้างอัตโนมัติจาก 3 บรรทัดข้างบน (docker-compose inject ให้)
# ไม่ต้องแก้บรรทัดนี้:
# DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}


# ============================================================
#  [2] SECURITY — JWT & Ingest API Key
# ============================================================

# JWT_SECRET: ใช้ sign token ของผู้ใช้งาน Dashboard
# สร้างด้วย: openssl rand -hex 32
JWT_SECRET=ChangeMe_RandomLongSecretKey_Here_Min32Chars

# INGEST_API_KEY: ใช้ป้องกันคนภายนอกยิง Log ปลอมเข้าระบบ
# ต้นทาง (Cowrie/WebTrap/Wazuh/ฯลฯ) ต้องส่ง Header นี้มาด้วย:
#   X-Ingest-Key: <ค่าที่ตั้งไว้ที่นี่>
# สร้างด้วย: openssl rand -hex 24
# ปล่อยว่างได้ถ้าระบบอยู่ในเครือข่ายภายในที่ Firewall ป้องกันแล้ว
INGEST_API_KEY=ChangeMe_IngestKey_Here


# ============================================================
#  [3] AI ANALYSIS — Google Gemini
# ============================================================
# ใช้วิเคราะห์ Alert ระดับ HIGH/CRITICAL อัตโนมัติ
# ขอ Key ได้ที่: https://aistudio.google.com/app/apikey
# ปล่อยว่างได้ถ้าไม่ต้องการ AI Analysis
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE


# ============================================================
#  [4] KKU SSO — SSONext Integration
# ============================================================
# ขอ Client ID/Secret จากทีม IT กลาง
# SSO_CALLBACK_URL ต้องตรงกับที่ลงทะเบียนไว้ใน SSONext Portal
SSO_CLIENT_ID=YOUR_SSO_APP_ID_HERE
SSO_CLIENT_SECRET=YOUR_SSO_CLIENT_SECRET_HERE
SSO_CALLBACK_URL=https://odt-siem-uat.kku.ac.th/callback


# ============================================================
#  [5] PORTS — External (เปิดรับจาก Internet / LAN)
# ============================================================

# ── Dashboard (ผ่าน Nginx Reverse Proxy) ─────────────────────
# ✅ จำเป็น — นี่คือช่องทางที่ SOC เข้าใช้งาน Dashboard
# Production จริงใช้ 80 และ 443 (ถ้า Nginx อยู่หน้าสุด)
# UAT/Dev ใช้ port สูงเพื่อหลีกเลี่ยงชนกับ service อื่น
HTTP_PORT=18080
HTTPS_PORT=18443

# ── SSH/Telnet Honeypot (Cowrie) ─────────────────────────────
# ✅ จำเป็น (SSH) — Hacker จะ connect มาที่ port นี้เพื่อดัก Credential
# ⚠️ Optional (Telnet) — ปิดได้ถ้าไม่ต้องการ Log Telnet
# ❗ ต้องเปิด Firewall ให้ port เหล่านี้รับ connection จากภายนอกด้วย
COWRIE_SSH_PORT=22222
COWRIE_TELNET_PORT=22223

# ── Web Vulnerability Honeypot (WebTrap) ─────────────────────
# ✅ จำเป็น (HTTP) — Hacker จะส่ง SQL Inject / XSS / Scan มาที่ port นี้
# ⚠️ Optional (HTTPS) — ต้องมี SSL cert ถึงจะทำงานได้
# ❗ ต้องเปิด Firewall ให้ port เหล่านี้รับ connection จากภายนอกด้วย
WEBTRAP_HTTP_PORT=28081
WEBTRAP_HTTPS_PORT=28444


# ============================================================
#  [6] PORTS — Internal Only (ไม่ต้องเปิด Firewall / ไม่เปิดออก Internet)
# ============================================================
# Backend  :5000  → เข้าถึงได้เฉพาะใน Docker network (Nginx proxy ให้)
# PostgreSQL:5432  → เข้าถึงได้เฉพาะใน Docker network
# Redis    :6379  → เข้าถึงได้เฉพาะใน Docker network
# (ไม่ต้องตั้งค่าอะไร — docker-compose จัดการให้อัตโนมัติ)


# ============================================================
#  [7] LOG INGEST ENDPOINT (สำหรับแจ้งทีมต้นทาง)
# ============================================================
# ทีมที่ต้องการส่ง Log เข้า Dashboard ใช้ข้อมูลนี้:
#
#   Method:  POST
#   URL:     https://[DOMAIN_ของ_คุณ]/api/ingest
#   Headers: Content-Type: application/json
#            X-Ingest-Key: [ค่าของ INGEST_API_KEY ข้างบน]
#   Body:    JSON Log ปกติของระบบต้นทาง (ไม่ต้องระบุ source)
#
# ตรวจสอบสถานะ:
#   GET https://[DOMAIN_ของ_คุณ]/api/ingest/status
