POSTGRES_USER=postgres
POSTGRES_PASSWORD=ChangeMe_StrongPassword_Here
POSTGRES_DB=honeypot

JWT_SECRET=ChangeMe_RandomLongSecretKey_Here_Min32Chars

INGEST_API_KEY=e270a4b8c39c2895f33bb91004dcea409f52b000f113480a

GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

SSO_CLIENT_ID=YOUR_SSO_APP_ID_HERE
SSO_CLIENT_SECRET=YOUR_SSO_CLIENT_SECRET_HERE
SSO_CALLBACK_URL=https://odt-siem-uat.kku.ac.th/callback

HTTP_PORT=18080
HTTPS_PORT=18443

COWRIE_SSH_PORT=22222

WEBTRAP_HTTP_PORT=28081

ATTACKER_MODE=AUTO
BURST_COUNT=30
MIN_DELAY_MS=2000
MAX_DELAY_MS=8000

# Developer API / MCP public address and browser origins
SIEM_PUBLIC_BASE_URL=https://odt-siem-uat.kku.ac.th
SIEM_MCP_ALLOWED_ORIGINS=https://odt-siem-uat.kku.ac.th
# Include the actual immediate reverse-proxy CIDRs when deployed behind nginx.
SIEM_TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128

# Required: 64-character hex string for 2FA encryption (must be static after first run)
TOTP_ENCRYPTION_KEY=Your_64_Character_Hex_Key_Here_e.g._0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Required: API keys for internal communication
DETECTION_API_KEY=Your_32_Character_Minimum_Key_Here
PDF_RENDER_KEY=Your_32_Character_Minimum_Key_Here


# Real host log directories. Set explicit mock directories only for local testing.
FIREWALL_LOG_DIR=/var/log/firewall
REVPROXY_LOG_DIR=/var/log/revproxy
# true replays the entire existing file on every Backend start; may produce duplicates.
SIEM_REPLAY_EXISTING_LOGS=false
